<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\UsbHelper.App\Assets\usb-helper.ico</ApplicationIcon>
    <!-- Native code, no .NET runtime to load: the splash shows within a fraction of a second (#110). -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Pinned: the SDK would add these at its own runtime version, so the lock file (restored with locked mode) would
       change with every SDK patch that CI installs. The ILCompiler package also sets the NativeAOT runtime pack it
       compiles against (Microsoft.NETCore.App.Runtime.NativeAOT.<rid>, same version), so compiler and runtime stay a
       pair. The launcher's code is still compiled against the SDK's own reference assemblies; within 10.0 patches
       these have the same API, which is why the pin's warnings are suppressed. Update both pins together, for
       example when CI's SDK moves to a newer 10.0 runtime. -->
  <PropertyGroup>
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.14" />
  </ItemGroup>

  <!-- The app's texts; one strings file for both. -->
  <ItemGroup>
    <EmbeddedResource Include="..\UsbHelper.App\Resources\Strings.resx" Link="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>UsbHelper.Launcher.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The published app, zipped (release.yml). Builds without it start nothing. -->
  <ItemGroup Condition="'$(AppPayload)' != ''">
    <EmbeddedResource Include="$(AppPayload)" LogicalName="app.zip" />
  </ItemGroup>

</Project>
