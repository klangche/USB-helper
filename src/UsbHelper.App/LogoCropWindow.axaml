<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsbHelper.App.ViewModels"
        xmlns:res="using:UsbHelper.App.Resources"
        x:Class="UsbHelper.App.LogoCropWindow"
        x:DataType="vm:LogoCropViewModel"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static res:Strings.LogoCropTitle}">

  <!-- #241: the fixed 3:1 frame (480 x 160) in the middle of the stage. The image is drawn over the whole stage; outside
       the frame it is dimmed, because that part is cut off. The dialog result is true for Save. -->
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{x:Static res:Strings.LogoCropHint}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />

    <Panel x:Name="Stage" Width="560" Height="240" ClipToBounds="True" Cursor="SizeAll" Background="#D8D8D8">
      <!-- A checkerboard in the frame, so transparency is visible. -->
      <Border Width="480" Height="160">
        <Border.Background>
          <VisualBrush TileMode="Tile" Stretch="None" SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
            <VisualBrush.Visual>
              <Canvas Width="16" Height="16" Background="White">
                <Rectangle Width="8" Height="8" Fill="LightGray" />
                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="LightGray" />
              </Canvas>
            </VisualBrush.Visual>
          </VisualBrush>
        </Border.Background>
      </Border>
      <Canvas>
        <Image x:Name="Picture" Stretch="Fill" />
      </Canvas>
      <!-- Dims everything outside the frame. -->
      <Path Fill="#99000000" Data="M0,0 H560 V240 H0 Z M40,40 V200 H520 V40 Z" />
      <Rectangle Width="482" Height="162" Stroke="White" StrokeThickness="1" />
    </Panel>

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <TextBlock Text="{x:Static res:Strings.LogoCropZoom}" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="-2" Maximum="3" Value="{Binding ZoomLevel}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="{x:Static res:Strings.LogoCropFit}" Click="FitClick" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.LogoCropSave}" IsDefault="True" Click="SaveClick" />
      <Button Content="{x:Static res:Strings.LogoCropCancel}" IsCancel="True" Click="CancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
