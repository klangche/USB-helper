<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:UsbHelper.App"
        xmlns:vm="using:UsbHelper.App.ViewModels"
        xmlns:sources="using:UsbHelper.App.Sources"
        xmlns:res="using:UsbHelper.App.Resources"
        x:Class="UsbHelper.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="700"
        Title="{x:Static res:Strings.WindowTitle}">

  <!-- F5 refreshes from anywhere in the window; the Refresh button left the top bar (owner order 2026-11-17). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </Window.KeyBindings>
  <DockPanel>

    <!-- Menu bar (#125): Alt or an underlined access key opens it. Settings (#126) comes later. -->
    <Menu x:Name="MenuBar" DockPanel.Dock="Top">
      <MenuItem Header="{x:Static res:Strings.MenuFile}">
        <MenuItem Header="{x:Static res:Strings.MenuRefresh}" Command="{Binding RefreshCommand}" InputGesture="F5" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuExportProfile}" Command="{Binding ExportProfileCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuExportLog}" Command="{Binding ExportLogCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuExportSetup}" Command="{Binding ExportSetupCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuExportPdf}" Command="{Binding ExportPdfCommand}"
                  ToolTip.Tip="{Binding ExportPdfTip}" ToolTip.ShowOnDisabled="True" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuSettings}" Command="{Binding SettingsCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.MenuEdit}">
        <MenuItem Header="{x:Static res:Strings.MenuCopyTree}" Command="{Binding CopyTreeCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.MenuHelp}">
        <MenuItem Header="{x:Static res:Strings.MenuCheckForUpdates}" Command="{Binding Update.CheckNow}"
                  IsEnabled="{Binding Update, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuUnlock}" Command="{Binding UnlockCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuAbout}" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- The top bar: the buttons from the left, the company branding (#229) in what is left at the right end. -->
    <DockPanel DockPanel.Dock="Top" HorizontalSpacing="8" Margin="12">
      <!-- The profile menu (#286): the guides on top, one at a time; below the line a tick per chip, any mix. -->
      <DropDownButton Content="{x:Static res:Strings.ProfileMenu}">
        <DropDownButton.Flyout>
          <!-- A click outside also reaches what is under it, so the other menu opens in one click (#295). -->
          <Flyout Placement="BottomEdgeAlignedLeft" OverlayDismissEventPassThrough="True">
            <ScrollViewer MaxHeight="480">
              <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{Binding Guides}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GuideOption">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- The line under the name is generated from a v4 guide's rules (#327). -->
                        <RadioButton GroupName="Guides" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" MaxWidth="360" />
                          </StackPanel>
                        </RadioButton>
                        <!-- The ProAV mark (#299): guides for ProAV rooms; a general-purpose guide such as USB Standard has none. -->
                        <Border IsVisible="{Binding IsProAv}" Background="#8A8A8A" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                          <TextBlock Text="{x:Static res:Strings.ProAvMark}" Foreground="White" FontSize="8" FontWeight="SemiBold" />
                        </Border>
                        <!-- Custom (#300), last and only while unlocked: opens its editor. -->
                        <Button Content="{x:Static res:Strings.CustomGuideEdit}" Command="{Binding EditCommand}"
                                IsVisible="{Binding IsCustom}" Padding="6,0" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator />
                <ItemsControl ItemsSource="{Binding PlatformGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlatformGroup">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- The name ticks or unticks all of its chips (#295); a plain word, not a button look. -->
                        <Button Classes="word" Content="{Binding Name}" Command="{Binding ToggleAll}" Width="120" FontWeight="SemiBold"
                                VerticalAlignment="Center" Cursor="Hand">
                          <Button.Styles>
                            <!-- Plain text in every state: no box, no hover or pressed background. -->
                            <Style Selector="Button.word">
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="BorderThickness" Value="0" />
                              <Setter Property="Padding" Value="0" />
                            </Style>
                            <Style Selector="Button.word:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="Button.word:pressed /template/ ContentPresenter#PART_ContentPresenter">
                              <Setter Property="Background" Value="Transparent" />
                            </Style>
                          </Button.Styles>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Chips}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileOption">
                              <CheckBox Content="{Binding ChipLabel}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Content="{x:Static res:Strings.Computers}">
        <DropDownButton.Flyout>
          <!-- A click outside also reaches what is under it, so the other menu opens in one click (#295). -->
          <Flyout Placement="BottomEdgeAlignedLeft" OverlayDismissEventPassThrough="True">
            <!-- The profile export of this computer sits on top of the list (#189). -->
            <StackPanel Spacing="4">
              <Button Content="{x:Static res:Strings.ExportProfile}" Command="{Binding ExportProfileCommand}" HorizontalAlignment="Stretch" />
              <Separator />
              <ScrollViewer MaxHeight="480">
                <ItemsControl ItemsSource="{Binding Computers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileOption">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <TextBlock Text="{Binding DetectedComputer}" VerticalAlignment="Center" Opacity="0.7" />
      <!-- Right-hand group, docked from the right edge inwards, so it follows the window's right side when it grows. -->
      <!-- The unlock popup (#238), only while locked; once unlocked the status line at the bottom says who it is unlocked to. -->
      <!-- From the left: PDF, Export, Log, Unlock (owner order 2026-11-17); Refresh is in the File menu and on F5. -->
      <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.UnlockOpen}" Command="{Binding UnlockCommand}" IsVisible="{Binding !Unlock.FeaturesUnlocked}" />
      <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.LogButton}" Click="OpenLog" />
      <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Export}" Command="{Binding ExportSetupCommand}" />
      <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.PdfButton}" Command="{Binding ExportPdfCommand}"
              ToolTip.Tip="{Binding ExportPdfTip}" ToolTip.ShowOnDisabled="True" />
      <TextBox DockPanel.Dock="Right" Text="{Binding RoomName}" PlaceholderText="{x:Static res:Strings.RoomName}" Width="220" />
      <!-- Company branding (#229), only while unlocked: the logo if there is one, otherwise the name, never both. The logo
           box is fixed at 96x32 and never shrinks (too narrow a window cuts off its right edge, no overlap); the logo is drawn in
           it with its aspect ratio kept. The name is
           trimmed when the window is narrow, shows in full on hover, and hides below 80 px before anything else shrinks. -->
      <Panel x:Name="Branding" HorizontalAlignment="Right" ClipToBounds="True" IsVisible="{Binding ShowsBranding}">
        <Image x:Name="BrandingLogo" Width="96" Height="32" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
               IsVisible="{Binding BrandingLogo, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <app:HideWhenNarrow MinShownWidth="80" VerticalAlignment="Center"
                            IsVisible="{Binding BrandingName, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding BrandingName}" ToolTip.Tip="{Binding BrandingName}" TextTrimming="CharacterEllipsis" />
        </app:HideWhenNarrow>
      </Panel>
    </DockPanel>

    <TextBlock x:Name="ExportResult" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="12,0,12,8"
               IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Status line (#238), always shown while unlocked: who it is unlocked to, or the free beta. It opens the unlock popup
         to view or remove the code. -->
    <Border x:Name="UnlockStatus" DockPanel.Dock="Bottom" IsVisible="{Binding Unlock.FeaturesUnlocked}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="12,2">
      <HyperlinkButton Content="{Binding Unlock.UnlockedText}" Command="{Binding UnlockCommand}" Padding="0" />
    </Border>

    <Grid ColumnDefinitions="3*,6,2*" Margin="12,0,12,12">

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadingStage}" IsVisible="{Binding IsLoading}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#C62828" />
        <!-- Tree style B (#43): drawn lines instead of indentation. Only the controllers can be collapsed (#142): a
             controller's chevron (#91), a double-click or the arrow keys hide or show its tree. Everything else stays open. -->
        <!-- Active cables and extenders the operating system does not show (#76, #90): click the "+" on the line to a hub
             or device, or press Enter or the context menu key on the selected item, to mark it: "+N hubs" adds N hubs and N
             tiers, "+N tiers" only N tiers (#307). -->
        <!-- A port with something on it is no row of its own (#264): its hub or device shows the port number in a small
             box and the USB-C badge. A row shows its result word and a light background only when it is not stable. -->
        <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}" x:Name="Tree" ContextRequested="OpenCableMark">
          <TreeView.Styles>
            <!-- The "+" on a connection line: a small ring and cross in the line's own colour, so the colour stays visible. -->
            <Style Selector="Button.cable">
              <Setter Property="Width" Value="10" />
              <Setter Property="Height" Value="10" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <ControlTemplate>
                  <Border Name="ring" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>
            <Style Selector="Button.cable:pointerover /template/ Border#ring">
              <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="Button.cable:focus-visible /template/ Border#ring">
              <Setter Property="BorderThickness" Value="2" />
            </Style>
            <!-- Expand/collapse (#91): a boxed chevron, right when collapsed and down when open. Not a "+", so it is not
                 taken for the active-cable "+" on the lines. -->
            <Style Selector="ToggleButton.expander">
              <Setter Property="Width" Value="16" />
              <Setter Property="Height" Value="16" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <ControlTemplate>
                  <Border Name="box" Background="Transparent" BorderBrush="#9E9E9E" BorderThickness="1" CornerRadius="3">
                    <Path Name="chevron" Data="M0,0 L3,3 L0,6" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>
            <Style Selector="ToggleButton.expander:checked /template/ Path#chevron">
              <Setter Property="Data" Value="M0,0 L3,3 L6,0" />
            </Style>
            <Style Selector="ToggleButton.expander:pointerover /template/ Border#box">
              <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </Style>
            <Style Selector="TextBlock.collapsed">
              <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="MinHeight" Value="0" />
              <!-- A border would add height to the row and break the lines between rows. -->
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Padding" Value="0" />
              <!-- The lines draw the indentation, so the item has none of its own and no expand arrow. -->
              <Setter Property="Template">
                <ControlTemplate>
                  <StackPanel>
                    <Border Name="PART_LayoutRoot" Classes="TreeViewItemLayoutRoot" Focusable="True"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            TemplatedControl.IsTemplateFocusTarget="True">
                      <ContentPresenter Name="PART_HeaderPresenter" Focusable="False" Background="Transparent"
                                        Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </Border>
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                                    IsVisible="{TemplateBinding IsExpanded}" />
                  </StackPanel>
                </ControlTemplate>
              </Setter>
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Rows}">
              <DockPanel Height="24" ToolTip.Tip="{Binding RowTip}"
                         Background="{Binding RowTint, Converter={x:Static app:HexBrushConverter.Instance}}">
                <app:TreeLines DockPanel.Dock="Left" Guides="{Binding Guides}" HasLine="{Binding HasLine}" IsLast="{Binding IsLastRow}"
                               HasChildren="{Binding ShowsChildren}" HasStatus="{Binding HasStatus}" IsDashed="{Binding IsUserMarked}"
                               TrunkAbove="{Binding TrunkAboveColor}" TrunkBelow="{Binding TrunkBelowColor}" Trunk="{Binding TrunkColor}"
                               ElbowBrush="{Binding ElbowColor, Converter={x:Static app:HexBrushConverter.Instance}}">
                  <Button Name="CableMark" Classes="cable" IsVisible="{Binding CanMark}" ToolTip.Tip="{x:Static res:Strings.CableMarkTip}"
                          AutomationProperties.Name="{x:Static res:Strings.CableMarkTitle}"
                          BorderBrush="{Binding ElbowColor, Converter={x:Static app:HexBrushConverter.Instance}}">
                    <Path Data="M0,2.5 H5 M2.5,0 V5" StrokeThickness="1.2"
                          Stroke="{Binding ElbowColor, Converter={x:Static app:HexBrushConverter.Instance}}" />
                    <Button.Flyout>
                      <!-- A plain menu (owner 2026-11-17): None, +1 / +2 (active extender) / +3 Hub, +1 / +2 Tier. A hub
                           mark adds as many tiers itself. A click outside also reaches what is under it (#295). -->
                      <MenuFlyout Placement="BottomEdgeAlignedLeft" OverlayDismissEventPassThrough="True">
                        <MenuItem Header="{Binding Source={x:Static vm:NodeViewModel.MarkChoices}, Path=[0]}" Command="{Binding SetMark}" CommandParameter="0" />
                        <MenuItem Header="{Binding Source={x:Static vm:NodeViewModel.MarkChoices}, Path=[1]}" Command="{Binding SetMark}" CommandParameter="1" />
                        <MenuItem Header="{Binding Source={x:Static vm:NodeViewModel.MarkChoices}, Path=[2]}" Command="{Binding SetMark}" CommandParameter="2" />
                        <MenuItem Header="{Binding Source={x:Static vm:NodeViewModel.MarkChoices}, Path=[3]}" Command="{Binding SetMark}" CommandParameter="3" />
                        <MenuItem Header="{Binding Source={x:Static vm:NodeViewModel.MarkChoices}, Path=[4]}" Command="{Binding SetMark}" CommandParameter="4" />
                        <MenuItem Header="{Binding Source={x:Static vm:NodeViewModel.MarkChoices}, Path=[5]}" Command="{Binding SetMark}" CommandParameter="5" />
                        <!-- An active cable with its length and bus (#331): each guide works out its tiers. -->
                        <Separator />
                        <MenuItem StaysOpenOnClick="True">
                          <MenuItem.Header>
                            <StackPanel Spacing="4">
                              <TextBlock Text="{x:Static res:Strings.MarkCableTitle}" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Value="{Binding CableMetres}" Minimum="0.5" Maximum="100" Increment="0.5" FormatString="0.#" Width="110" />
                                <ComboBox ItemsSource="{x:Static vm:NodeViewModel.CableBuses}" SelectedIndex="{Binding CableBusIndex}" />
                                <Button Content="{x:Static res:Strings.MarkCableSet}" Command="{Binding SetCable}" CommandParameter="0" />
                              </StackPanel>
                            </StackPanel>
                          </MenuItem.Header>
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </app:TreeLines>
                <!-- A hub's or device's depth at the right (#264): "Tier 4, 2 hubs in front" (#307). -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding DepthText}" Opacity="0.7" Margin="8,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,8,0" VerticalAlignment="Center">
                  <ToggleButton Classes="expander" IsVisible="{Binding CanExpand}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                ToolTip.Tip="{x:Static res:Strings.ExpandTip}" AutomationProperties.Name="{x:Static res:Strings.ExpandTip}" />
                  <!-- The number of the port this hub or device is on. -->
                  <Border Background="#339E9E9E" CornerRadius="3" Padding="4,0" MinWidth="16" VerticalAlignment="Center"
                          IsVisible="{Binding PortNumber, Converter={x:Static ObjectConverters.IsNotNull}}"
                          ToolTip.Tip="{Binding PortName}">
                    <TextBlock Text="{Binding PortNumber}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </Border>
                  <!-- A marked line's "+2 hubs" or "+1 tier" badge, in the line's colour, so it is clear the user added it. -->
                  <Border BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center" IsVisible="{Binding IsUserMarked}"
                          BorderBrush="{Binding ElbowColor, Converter={x:Static app:HexBrushConverter.Instance}}">
                    <TextBlock Text="{Binding MarkBadge}" FontWeight="SemiBold"
                               Foreground="{Binding ElbowColor, Converter={x:Static app:HexBrushConverter.Instance}}" />
                  </Border>
                  <!-- A DisplayLink device is a display (#92): a badge and its message before its name, so a long row never
                       cuts the message off. -->
                  <Border BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center" IsVisible="{Binding IsDisplay}"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <TextBlock Text="{x:Static res:Strings.DisplayBadge}" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding DisplayNote}" IsVisible="{Binding IsDisplay}" />
                  <!-- The status dot, in the same colour as the elbow. -->
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding HasStatus}"
                           Fill="{Binding LineColor, Converter={x:Static app:HexBrushConverter.Instance}}" />
                  <!-- A collapsed item's name is bold (#100). -->
                  <TextBlock Text="{Binding Text}" Classes.collapsed="{Binding IsCollapsed}" />
                  <!-- A port Windows reports as USB-C (#114). -->
                  <Border BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center"
                          IsVisible="{Binding PortBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <TextBlock Text="{Binding PortBadge}" />
                  </Border>
                  <!-- A warning that is not a status (#296): "⚠ no MST" on a display duplicated for lack of MST. -->
                  <!-- The triangle at the text's size, "no MST" smaller, in the warning's orange; hovering the row explains it. -->
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                              IsVisible="{Binding WarningBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="⚠" Foreground="#EF6C00" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static res:Strings.NoMstShort}" FontSize="10" FontWeight="SemiBold" Foreground="#EF6C00"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- The result word, in the same colour as the elbow, only when the row is not stable. -->
                  <TextBlock Text="{Binding RowStatusWord}" FontWeight="SemiBold"
                             IsVisible="{Binding RowStatusWord, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Foreground="{Binding LineColor, Converter={x:Static app:HexBrushConverter.Instance}}" />
                  <TextBlock Text="{Binding DisplayNote}" IsVisible="{Binding HasDisplayBelow}" />
                  <!-- "Hubs: 4 (3+1), ...": the hubs per bus in brackets, USB 2, USB 3 (#217, #298), then any USB4 routers (#359); hovering
                       shows the text and which bus is which. -->
                  <StackPanel Orientation="Horizontal" Opacity="0.7" ToolTip.Tip="{Binding CountsTip}"
                              IsVisible="{Binding Counts, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding CountsHead}" />
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding HasCountsPerBus}">
                      <TextBlock Text="{Binding CountsUsb2}" FontWeight="SemiBold" />
                      <TextBlock Text="+" />
                      <TextBlock Text="{Binding CountsUsb3}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding CountsTail}" />
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="10" Margin="8,0,0,0">

          <StackPanel IsVisible="{Binding HasDatabaseErrors}" Spacing="4">
            <TextBlock Text="{x:Static res:Strings.DatabaseErrors}" FontWeight="Bold" TextWrapping="Wrap" Foreground="#C62828" />
            <ItemsControl ItemsSource="{Binding DatabaseErrors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="monospace" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Background="{Binding OverallColor, Converter={x:Static app:HexBrushConverter.Instance}}" CornerRadius="4" Padding="8">
            <TextBlock Text="{Binding OverallText}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" />
          </Border>

          <!-- Status field: every checked profile with its result word in its colour, for the selected controller. -->
          <TextBlock Text="{x:Static res:Strings.StatusField}" FontWeight="Bold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding StatusScope}" TextWrapping="Wrap" />
          <!-- The setup moved to another of the computer's ports (#342). -->
          <TextBlock Text="{Binding PortStatus}" IsVisible="{Binding HasPortStatus}" TextWrapping="Wrap" FontStyle="Italic" />
          <!-- Which guide every result is judged by (#286). -->
          <!-- The guide's name links to its page when its file lists one. -->
          <WrapPanel Opacity="0.7" IsVisible="{Binding Guide, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding GuideTextBefore}" VerticalAlignment="Center" />
            <HyperlinkButton Content="{Binding GuideName}" NavigateUri="{Binding GuideLink}" IsVisible="{Binding HasGuideLink}"
                             Padding="0" VerticalAlignment="Center" ToolTip.Tip="{Binding GuideLink}" />
            <TextBlock Text="{Binding GuideName}" IsVisible="{Binding HasGuideNoLink}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GuideTextAfter}" VerticalAlignment="Center" />
          </WrapPanel>
          <!-- Every PDF and link of the guide's sources (#333): a PDF opens in the built-in viewer, a link in the browser. -->
          <WrapPanel Opacity="0.7" IsVisible="{Binding HasGuideSources}">
            <TextBlock Text="{x:Static res:Strings.SourcesLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ItemsControl ItemsSource="{Binding GuideSources}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sources:SourceEntry">
                  <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,10,0">
                    <Border IsVisible="{Binding IsPdf}" Background="#B03A2E" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static res:Strings.PdfMark}" Foreground="White" FontSize="8" FontWeight="SemiBold" />
                    </Border>
                    <HyperlinkButton Content="{Binding Name}" ToolTip.Tip="{Binding Tip}" Padding="0" VerticalAlignment="Center" Click="OpenSource" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
          <TextBlock Text="{x:Static res:Strings.NothingChecked}" IsVisible="{Binding NothingChecked}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding StatusRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatusRow">
                <StackPanel Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="{Binding Color, Converter={x:Static app:HexBrushConverter.Instance}}" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding Word}" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Counts table (#265), for what the status field covers: "Hubs: 3 (2+1+0)" (#298) and "Devices: 7" (#307), then one line per bus with
               its own hubs and deepest tier; one combined line when no bus is reported. Not shown when nothing is connected. -->
          <StackPanel IsVisible="{Binding HasBusCounts}" Spacing="2" Margin="0,8,0,0">
            <TextBlock Text="{x:Static res:Strings.CountsTable}" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusScope}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BusCountsHubs}" ToolTip.Tip="{x:Static res:Strings.CountsPerBusTip}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BusCountsDevices}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="3*,2*,3*" Opacity="0.7">
              <TextBlock Grid.Column="1" Text="{x:Static res:Strings.CountsColumnHubs}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="2" Text="{x:Static res:Strings.LimitTiers}" TextWrapping="Wrap" />
            </Grid>
            <ItemsControl ItemsSource="{Binding BusCountsRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BusCountsRow">
                  <Grid ColumnDefinitions="3*,2*,3*">
                    <TextBlock Grid.Column="0" Text="{Binding Bus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Hubs}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{Binding DeepestTier}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="{x:Static res:Strings.Disconnected}" FontWeight="Bold" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Disconnected}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DisconnectedItem">
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Clear}" Command="{Binding Clear}" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{x:Static res:Strings.Findings}" FontWeight="Bold" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FindingItem">
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
