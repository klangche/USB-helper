<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsbHelper.App.ViewModels"
        xmlns:res="using:UsbHelper.App.Resources"
        xmlns:app="using:UsbHelper.App"
        x:Class="UsbHelper.App.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="460" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static res:Strings.SettingsTitle}">

  <!-- Each change is saved at once (#126), so there is no Save or Cancel. -->
  <StackPanel Margin="16" Spacing="10">
    <CheckBox Content="{x:Static res:Strings.SettingsCheckForUpdates}" IsChecked="{Binding CheckForUpdatesAtStart}" />
    <!-- Newer database files without a new app version (#290). -->
    <CheckBox Content="{x:Static res:Strings.SettingsDownloadDatabase}" IsChecked="{Binding DownloadDatabaseUpdates}" />
    <!-- Beta updates only while unlocked (#246): disabled and unticked while locked; the stored choice is kept. -->
    <CheckBox Content="{x:Static res:Strings.SettingsOfferBetas}" IsChecked="{Binding BetasOffered}" IsEnabled="{Binding BetasUnlocked}" />
    <HyperlinkButton Content="{x:Static res:Strings.UnlockBetasNeeded}" IsVisible="{Binding !BetasUnlocked}" Click="OpenUnlock" Padding="0" />
    <CheckBox Content="{x:Static res:Strings.SettingsRememberProfiles}" IsChecked="{Binding RememberCheckedProfiles}" />

    <!-- Company branding (#228). The name is saved when the box loses focus, so it is trimmed only once typing is done.
         Locked until an unlock code gives Pro (#234): shown but disabled, and the stored name and logo are kept. -->
    <TextBlock Text="{x:Static res:Strings.SettingsCompanyName}" Margin="0,6,0,0" />
    <!-- Opens the unlock popup (#238). -->
    <HyperlinkButton Content="{x:Static res:Strings.UnlockNeeded}" IsVisible="{Binding !BrandingUnlocked}" Click="OpenUnlock" Padding="0" />
    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding BrandingUnlocked}" />
    <TextBlock Text="{x:Static res:Strings.SettingsCompanyLogo}" />
    <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding BrandingUnlocked}">
      <!-- A checkerboard behind the preview, so transparency is visible. The logo is always 3:1 (#241), and so is the box. -->
      <Border Width="194" Height="66" BorderBrush="Gray" BorderThickness="1">
        <Border.Background>
          <VisualBrush TileMode="Tile" Stretch="None" SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
            <VisualBrush.Visual>
              <Canvas Width="16" Height="16" Background="White">
                <Rectangle Width="8" Height="8" Fill="LightGray" />
                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="LightGray" />
              </Canvas>
            </VisualBrush.Visual>
          </VisualBrush>
        </Border.Background>
        <Image x:Name="LogoImage" Stretch="Uniform" />
      </Border>
      <StackPanel Spacing="6" VerticalAlignment="Center">
        <Button Content="{x:Static res:Strings.SettingsChooseLogo}" Click="ChooseLogo" />
        <Button Content="{x:Static res:Strings.SettingsAdjustCrop}" Click="AdjustCrop" IsEnabled="{Binding LogoPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{x:Static res:Strings.SettingsRemoveLogo}" Click="RemoveLogo" IsEnabled="{Binding LogoPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>
    <TextBlock Text="{Binding LogoMessage}" IsVisible="{Binding LogoMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
               TextWrapping="Wrap" Foreground="#C42B1C" />
    <!-- A logo too weak on a theme (#340): invert it, with a preview first, or upload one for that theme. Never a
         background plate. Once the theme has its own logo, it shows with Remove. -->
    <ItemsControl ItemsSource="{Binding ThemeOffers}" IsEnabled="{Binding BrandingUnlocked}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ThemeLogoViewModel">
          <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding Offered}">
            <TextBlock Text="{Binding HardToSee}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image Width="96" Height="32" Stretch="Uniform" IsVisible="{Binding HasOwnLogo}"
                     Source="{Binding OwnLogo, Converter={x:Static app:PngConverter.Instance}}" />
              <Image Width="96" Height="32" Stretch="Uniform" IsVisible="{Binding Previewing}"
                     Source="{Binding InvertPreview, Converter={x:Static app:PngConverter.Instance}}" />
              <Button Content="{x:Static res:Strings.LogoInvert}" Click="InvertThemeLogo" IsVisible="{Binding ShowsChoices}" />
              <Button Content="{Binding UploadLabel}" Click="UploadThemeLogo" IsVisible="{Binding ShowsChoices}" />
              <Button Content="{x:Static res:Strings.LogoKeepInverted}" Click="KeepInvertedLogo" IsVisible="{Binding Previewing}" />
              <Button Content="{x:Static res:Strings.LogoCancelInvert}" Click="CancelInvertedLogo" IsVisible="{Binding Previewing}" />
              <Button Content="{x:Static res:Strings.SettingsRemoveLogo}" Click="RemoveThemeLogo" IsVisible="{Binding HasOwnLogo}" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap" Foreground="#C42B1C" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{x:Static res:Strings.SettingsSavedAt}" TextWrapping="Wrap" Opacity="0.7" />
    <SelectableTextBlock Text="{Binding FilePath}" TextWrapping="Wrap" FontFamily="monospace" Opacity="0.7" />

    <Button Content="{x:Static res:Strings.SettingsClose}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="CloseWindow" />
  </StackPanel>
</Window>
