<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsbHelper.App.ViewModels"
        xmlns:res="using:UsbHelper.App.Resources"
        x:Class="UsbHelper.App.UnlockWindow"
        x:DataType="vm:UnlockViewModel"
        Width="420" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static res:Strings.UnlockTitle}">

  <!-- #238: the email and unlock code. A valid pair closes the popup; once unlocked by a code it shows who it is unlocked
       to and Remove code. -->
  <StackPanel Margin="16" Spacing="6">
    <StackPanel Spacing="6" IsVisible="{Binding !IsUnlocked}">
      <TextBlock Text="{x:Static res:Strings.UnlockEmail}" />
      <TextBox Text="{Binding Email}" />
      <TextBlock Text="{x:Static res:Strings.UnlockCode}" />
      <TextBox Text="{Binding Code}" FontFamily="monospace" />
    </StackPanel>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Text="{x:Static res:Strings.SupportNote}" TextWrapping="Wrap" Opacity="0.7" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="{x:Static res:Strings.UnlockButton}" Command="{Binding UnlockCommand}" IsDefault="True" IsVisible="{Binding !IsUnlocked}" />
      <Button Content="{x:Static res:Strings.UnlockRemove}" Command="{Binding RemoveCommand}" IsVisible="{Binding IsUnlocked}" />
      <Button Content="{x:Static res:Strings.UnlockCancel}" IsCancel="True" Click="CancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
