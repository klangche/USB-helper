<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsbHelper.App.ViewModels"
        xmlns:res="using:UsbHelper.App.Resources"
        x:Class="UsbHelper.App.CustomGuideWindow"
        x:DataType="vm:CustomGuideViewModel"
        Width="820" Height="680" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static res:Strings.CustomGuideTitle}">

  <!-- #300: custom.yaml as text. Save writes it only when it is a valid guide; else the problems are listed by line. -->
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.CustomGuideIntro}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="{x:Static res:Strings.CustomGuideDownload}" Click="DownloadBlank" />
      <Button Content="{x:Static res:Strings.CustomGuideOpen}" Click="OpenFile" />
      <Button Content="{x:Static res:Strings.CustomGuideSave}" Command="{Binding SaveCommand}" />
      <Button Content="{x:Static res:Strings.CustomGuideClose}" IsCancel="True" Click="CloseClick" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ScrollViewer MaxHeight="140" IsVisible="{Binding HasErrors}">
        <ItemsControl ItemsSource="{Binding Errors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <SelectableTextBlock Text="{Binding}" FontFamily="monospace" TextWrapping="Wrap" Foreground="#C62828" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
    <TextBox Text="{Binding Text}" FontFamily="monospace" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
