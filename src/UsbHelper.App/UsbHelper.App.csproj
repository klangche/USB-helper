<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- UsbHelper.exe in the release zip's USB-helper folder (#123). Not USB-helper.exe: the 0.5.0 launcher's update
         would take an exe of that name for a new launcher. The namespace stays the project's. -->
    <AssemblyName>UsbHelper</AssemblyName>
    <RootNamespace>UsbHelper.App</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The exe icon on Windows; on every system Avalonia makes it each window's icon. Assets/make-icon.sh generates it from the SVG. -->
    <ApplicationIcon>Assets\usb-helper.ico</ApplicationIcon>
    <!-- Published builds are compiled ahead of time, so the app starts without waiting for the JIT compiler. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Windows only (#160): no console window and the Windows manifest. Other systems get a plain executable. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Reads company logos in SVG (#228). -->
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

  <!-- The icon in the About window. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\usb-helper.ico" />
  </ItemGroup>

  <!-- CompanyLogo.MoveFolder, replaced by a test to make the logo swap fail (#228). -->
  <ItemGroup>
    <InternalsVisibleTo Include="UsbHelper.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsbHelper.Core\UsbHelper.Core.csproj" />
    <!-- Plain managed code with P/Invoke: it builds on every system, and only runs when the app picks it on Windows. -->
    <ProjectReference Include="..\UsbHelper.Detection.Windows\UsbHelper.Detection.Windows.csproj" />
    <!-- Same for macOS: it uses IOKit only when the app picks it on macOS. -->
    <ProjectReference Include="..\UsbHelper.Detection.MacOS\UsbHelper.Detection.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>UsbHelper.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The hardware database is built into the app (#102); database/ in the repository is its source. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\database\**\*.yaml" LogicalName="database/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
