<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- A broken database, embedded the way the app embeds database/, for the error tests. -->
  <ItemGroup>
    <EmbeddedResource Include="BrokenDatabase\**\*.yaml" LogicalName="database/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Golden files of a setup export (#135), read from the output folder. -->
  <ItemGroup>
    <None Include="Setup\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UsbHelper.App\UsbHelper.App.csproj" />
    <ProjectReference Include="..\..\src\UsbHelper.Core\UsbHelper.Core.csproj" />
  </ItemGroup>

</Project>
